#!/usr/bin/env python3
"""Keep one OpenCode session working; hand off exclusive GPU work between turns."""
import argparse
import json
import os
from pathlib import Path
import re
import signal
import subprocess
import sys
import time
import urllib.error
import urllib.request
import uuid

CONTINUE = (
    "Review the original task and work so far. Choose and execute the next useful "
    "step. Preserve evidence and avoid repeating failed actions without new evidence."
)
HANDOFF = (
    "For a long GPU training job, first save its reproducible inputs and outputs. "
    "If an exclusive MTPLX GPU handoff is configured, register it using "
    "`oc-run train -- <program> <arguments>` from a shell tool, without nohup, "
    "disown, '&', or a separate background process. Then end this OpenCode turn "
    "so the controller can unload the model, run training, restore the model and "
    "continue this same session. Never expose credentials in tool output. "
    "If handoff is unavailable, do not launch a competing long GPU job; report "
    "the proposed command instead."
)


def duration(text):
    m = re.fullmatch(r"(\d+(?:\.\d+)?)(s|m|h)", text)
    if not m or float(m[1]) <= 0:
        raise argparse.ArgumentTypeError("duration must be positive: 15m, 2h or 10h")
    return float(m[1]) * {"s": 1, "m": 60, "h": 3600}[m[2]]


def private_directory(path):
    path.mkdir(mode=0o700, parents=True, exist_ok=False)
    path.chmod(0o700)
    return path


def save_json(path, payload):
    temp = path.with_name(path.name + ".tmp")
    fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            json.dump(payload, stream, indent=2)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temp, path)
    finally:
        if temp.exists():
            temp.unlink()


def register_training(argv):
    path = os.environ.get("OC_RUN_HANDOFF_FILE")
    root = os.environ.get("OC_RUN_WORKSPACE")
    if not path or not root:
        raise SystemExit("No active OC Run GPU handoff. Training not started.")
    if not argv:
        raise SystemExit("Specify training argv after -- (no shell operators).")
    if any(a in {"&", "nohup", "disown", "|", ";"} for a in argv):
        raise SystemExit("Background and shell operators are not permitted.")
    destination = Path(path)
    if destination.exists():
        raise SystemExit("A GPU handoff request already exists; training not started.")
    data = {"argv": argv, "cwd": root}
    fd = os.open(destination, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(data, f)
        f.write("\n")
    print("GPU training registered. End this OpenCode turn; OC Run will run it after model unload.")


def read_lifecycle(path):
    obj = json.loads(path.read_text(encoding="utf-8"))
    if obj.get("exclusive") is not True:
        raise ValueError("lifecycle config must explicitly assert exclusive MTPLX use")
    for name in ("stop", "start"):
        value = obj.get(name)
        if not isinstance(value, list) or not value or not all(isinstance(v, str) and v for v in value):
            raise ValueError(f"{name} must be a non-empty JSON argv array")
    if not isinstance(obj.get("model_id"), str) or not obj["model_id"]:
        raise ValueError("model_id must name the existing MTPLX served model")
    url = obj.get("health", "http://127.0.0.1:8000/health")
    if not re.fullmatch(r"http://(?:127\.0\.0\.1|localhost):\d+/health", url):
        raise ValueError("health must point to a loopback MTPLX /health endpoint")
    return obj


def health(url):
    try:
        with urllib.request.urlopen(url, timeout=2) as response:
            return response.status == 200
    except (OSError, urllib.error.URLError):
        return False


def matches_model(url, model_id):
    try:
        models_url = url.removesuffix("/health") + "/v1/models"
        with urllib.request.urlopen(models_url, timeout=3) as response:
            data = json.load(response)
        return any(item.get("id") == model_id for item in data.get("data", []))
    except (OSError, ValueError, urllib.error.URLError):
        return False


def await_health(url, desired, seconds=60):
    end = time.monotonic() + seconds
    while time.monotonic() < end:
        if health(url) is desired:
            return True
        time.sleep(0.4)
    return health(url) is desired


def run_command(argv, cwd, output_path, env=None, foreground=True):
    with output_path.open("wb") as output:
        proc = subprocess.Popen(argv, cwd=cwd, env=env, stdin=subprocess.DEVNULL,
                                stdout=output, stderr=subprocess.STDOUT,
                                start_new_session=True)
        if not foreground:
            return proc
        try:
            return proc.wait()
        except KeyboardInterrupt:
            # Do not silently orphan or forcibly kill potentially checkpointing work.
            os.killpg(proc.pid, signal.SIGINT)
            try:
                proc.wait(timeout=30)
            except subprocess.TimeoutExpired:
                print(f"Training PID {proc.pid} still running after interrupt. "
                      f"Inspect {output_path}; model remains unloaded.", file=sys.stderr)
                raise RuntimeError("training still active; manual recovery required")
            raise


def gpu_handoff(request_file, lifecycle, logdir, root):
    data = json.loads(request_file.read_text(encoding="utf-8"))
    if data.get("cwd") != str(root) or not isinstance(data.get("argv"), list) or not data["argv"]:
        raise ValueError("invalid or mismatched training request")
    cmd = data["argv"]
    if not all(isinstance(x, str) and x for x in cmd):
        raise ValueError("training command must contain only non-empty strings")
    url = lifecycle.get("health", "http://127.0.0.1:8000/health")
    if not health(url) or not matches_model(url, lifecycle["model_id"]):
        raise RuntimeError("expected MTPLX model not serving: refusing unload and training")
    print("GPU handoff: stopping exclusive MTPLX model server", flush=True)
    stop_rc = run_command(lifecycle["stop"], root, logdir / "mtplx-stop.log")
    if stop_rc != 0 or not await_health(url, False):
        raise RuntimeError("MTPLX unload unverified. Training was NOT started; inspect logs")
    # A stopped server process releases its own Metal allocations. Do not infer
    # availability of memory held by other unrelated applications.
    request_file.rename(logdir / "training-request.accepted.json")
    train_rc = None
    interrupted = False
    safe_to_restore = True
    try:
        print("GPU handoff: running registered training; model server offline", flush=True)
        train_rc = run_command(cmd, root, logdir / "training.log")
    except KeyboardInterrupt:
        interrupted = True
    except RuntimeError:
        safe_to_restore = False  # Training is still active: no competing Sage reload.
        raise
    finally:
        if safe_to_restore:
            print("GPU handoff: restoring MTPLX", flush=True)
            server = run_command(lifecycle["start"], root, logdir / "mtplx-start.log", foreground=False)
            if not await_health(url, True, seconds=120) or not matches_model(url, lifecycle["model_id"]):
                raise RuntimeError(f"MTPLX restoration/model identity unverified (PID {server.pid}); manual recovery required")
    save_json(logdir / "training-result.json", {"exit_code": train_rc, "interrupted": interrupted})
    if interrupted:
        raise KeyboardInterrupt
    return train_rc


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "train":
        args = sys.argv[2:]
        if args and args[0] == "--":
            args = args[1:]
        register_training(args)
        return 0
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("budget", type=duration)
    parser.add_argument("prompt", nargs="+")
    parser.add_argument("--gpu-lifecycle", type=Path, help="opt-in exclusive MTPLX stop/start argv JSON")
    args = parser.parse_args()
    root = Path.cwd().resolve()
    base = Path(os.environ.get("OC_RUN_STATE_DIR", "~/.local/state/oc-run")).expanduser()
    base.mkdir(mode=0o700, parents=True, exist_ok=True)
    logdir = private_directory(base / ("timer-" + time.strftime("%Y%m%dT%H%M%S") + "-" + uuid.uuid4().hex[:8]))
    session = "ses_" + uuid.uuid4().hex
    lifecycle = read_lifecycle(args.gpu_lifecycle) if args.gpu_lifecycle else None
    deadline = time.monotonic() + args.budget
    print(f"Logs: {logdir}\nSession: {session}\nBudget: {args.budget:g}s", flush=True)
    prompt = " ".join(args.prompt)
    if lifecycle:
        prompt += "\n\n" + HANDOFF
    turn = 0
    fast_no_tool = 0
    while True:
        turn += 1
        request_file = logdir / "training-request.json"
        env = os.environ.copy()
        if lifecycle:
            env["OC_RUN_HANDOFF_FILE"] = str(request_file)
            env["OC_RUN_WORKSPACE"] = str(root)
        else:
            env.pop("OC_RUN_HANDOFF_FILE", None)
            env.pop("OC_RUN_WORKSPACE", None)
        binary = os.environ.get("OC_NATIVE_BIN", "opencode")
        command = [binary, "run", "--standalone", "--format", "json", "--session", session]
        agent = os.environ.get("OC_NATIVE_AGENT")
        if agent:
            command += ["--agent", agent]
        elapsed_start = time.monotonic()
        print(f"Starting OpenCode turn {turn}", flush=True)
        try:
            with (logdir / f"{turn:04d}.stdout.jsonl").open("wb") as out, (logdir / f"{turn:04d}.stderr.log").open("wb") as err:
                rc = subprocess.run(command, input=prompt.encode(), cwd=root, env=env,
                                    stdout=out, stderr=err, check=False).returncode
        except KeyboardInterrupt:
            print(f"Interrupted. Session {session}; logs {logdir}", file=sys.stderr)
            return 130
        except OSError as ex:
            print(f"Could not start OpenCode: {ex}; logs {logdir}", file=sys.stderr)
            return 1
        elapsed = time.monotonic() - elapsed_start
        print(f"Turn {turn}: exit {rc}, {elapsed:.1f}s", flush=True)
        if rc != 0:
            print("Native execution failed; no training launched. Inspect raw logs.", file=sys.stderr)
            return 1
        summary = ""
        if request_file.exists():
            if not lifecycle:
                print("Unexpected training request without lifecycle; refusing", file=sys.stderr)
                return 1
            try:
                train_rc = gpu_handoff(request_file, lifecycle, logdir, root)
            except (OSError, ValueError, RuntimeError) as exc:
                print(f"GPU handoff failed: {exc}; logs {logdir}", file=sys.stderr)
                return 1
            except KeyboardInterrupt:
                print(f"Interrupted; logs {logdir}", file=sys.stderr)
                return 130
            summary = f"The GPU training subprocess exited {train_rc}. Inspect training.log and outputs. "
            if train_rc != 0:
                print(f"Training failed with exit {train_rc}; Sage can diagnose, not silently repeat.")
            fast_no_tool = 0
        else:
            # Only a very short tool-free round contributes to the loop guard.
            uses_tool = False
            try:
                with (logdir / f"{turn:04d}.stdout.jsonl").open(encoding="utf-8") as f:
                    uses_tool = any('"type":"tool_use"' in line or '"type": "tool_use"' in line for line in f)
            except OSError:
                pass
            fast_no_tool = fast_no_tool + 1 if elapsed < 2 and not uses_tool else 0
            if fast_no_tool >= 3:
                print("Stopped: three immediate tool-free turns; inspect session.")
                break
        if time.monotonic() >= deadline:
            print("Budget elapsed; no new OpenCode turn.", flush=True)
            break
        prompt = summary + CONTINUE
    print(f"Session: {session}; logs: {logdir}", flush=True)
    return 0


if __name__ == "__main__":
    sys.exit(main())
